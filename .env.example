# Elastik testground environment contract.
#
# Core bind address. Rust core defaults to 127.0.0.1:3105.
ELASTIK_HOST=127.0.0.1
ELASTIK_PORT=3105

# Optional SCoAP/UDP surface. Disabled unless ELASTIK_COAP_PORT is set.
# ELASTIK_COAP_HOST defaults to 127.0.0.1 when enabled.
# ELASTIK_COAP_HOST=127.0.0.1
# ELASTIK_COAP_PORT=5683

# SDK client target. If unset, SDKs derive http://ELASTIK_HOST:ELASTIK_PORT
# or fall back to http://127.0.0.1:3105.
ELASTIK_URL=http://127.0.0.1:3105

# Storage root. This is the dataset selector: point the same binary at
# another folder and it serves another Elastik universe.
#
# Examples:
#   ELASTIK_DATA=./data
#   ELASTIK_DATA=C:\Users\chenh\elastik-data
#   ELASTIK_DATA=Z:\elastik-data
#
# Use local SSD/tempdir for writes. Synced folders and network shares are
# useful for distribution/serve, but SQLite-on-network-FS should be treated
# carefully for concurrent writes.
ELASTIK_DATA=./data

# Resource caps. Single HTTP request bodies are capped at 64 MiB in the core.
# These knobs cap stored representation size, durable storage quota,
# memory-backed world bytes, SSE connection/replay budgets, and CoAP in-flight
# work. Zero/non-numeric values fall back to defaults for connection/replay/CoAP
# caps. ELASTIK_MAX_STORAGE_BYTES is unlimited when unset, empty, or zero;
# invalid non-numeric values fail startup so quota typos do not silently disable
# it. The quota counts durable body bytes, not SQLite/audit-log file overhead.
ELASTIK_MAX_WORLD_BYTES=67108864
# ELASTIK_MAX_STORAGE_BYTES=10737418240
ELASTIK_MAX_MEMORY_BYTES=268435456
ELASTIK_MAX_LISTEN_CONNECTIONS=1024
ELASTIK_LISTEN_REPLAY_MAX=1024
ELASTIK_COAP_MAX_IN_FLIGHT=1024
# Per-world SQLite read connection cache cap. Each cached entry
# bounds memory to ~250 KiB via PRAGMA cache_size=-200; default 5000
# entries puts the worst-case at ~1.25 GiB. At-cap reads still go
# through the SlotState protocol via a transient slot (see
# AGENTS.md "Drain before remove") -- the cap controls
# persistence, not safety registration. Surface the actual hit /
# miss / capped counts via /proc/pool. Zero or non-numeric values
# fall back to the default.
ELASTIK_READ_CACHE_MAX_ENTRIES=5000

# Custom representation headers to persist with the body
# (Layer 3 of the four-layer persist policy). The built-in
# default-allow set (Layer 2) already covers standard
# representation headers without configuration:
#   Content-Disposition, Content-Encoding, Content-Language,
#   Content-MD5, Cache-Control, Expires, the full
#   Access-Control-Allow-* / Access-Control-Expose-Headers /
#   Access-Control-Max-Age CORS family,
#   Content-Security-Policy(-Report-Only), X-Frame-Options,
#   Permissions-Policy, Cross-Origin-Resource-Policy,
#   Cross-Origin-Opener-Policy, Cross-Origin-Embedder-Policy,
#   Referrer-Policy, X-Robots-Tag.
# This knob only adds custom names like X-Author or X-My-Tag.
# Comma-separated; trailing `*` is a prefix match (`x-my-*`
# matches everything starting with `x-my-`). Default unset =
# no custom headers round-trip beyond the built-in set.
# ELASTIK_PERSIST_HEADERS=x-author,x-version,x-my-*

# Subtract entries from the built-in default-allow set
# (Layer 1.5). Use this if your deployment doesn't want a
# specific standard header round-tripping (e.g.
# `cache-control` because you serve everything fresh). Same
# matcher shape as ELASTIK_PERSIST_HEADERS. Hard-deny (Layer 1)
# still overrides this for security/transport/tracing/cloud
# pollutants. Default unset = no entries subtracted.
#
# Affects future writes only: changing this list does NOT scrub
# already-persisted headers. Operators wanting to remove a
# header from existing worlds must re-PUT those worlds (the
# write filter runs at PUT time, the read filter only re-checks
# Layer 1 hard deny).
# ELASTIK_DENY_HEADERS=cache-control,expires

# Audit-chain HMAC key. Required by the Rust core. The SDK no longer
# substitutes a constant default. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ELASTIK_KEY=change-me-local-dev-key

# Tokens. Empty means that tier is disabled.
# If ELASTIK_READ_TOKEN is empty, reads stay public.
# Set it to make GET, HEAD, /listen/*, and read-only /proc/* require auth.
# OPTIONS remains policy-free capability discovery.
# Example local-dev values:
#   ELASTIK_READ_TOKEN=read-token
#   ELASTIK_WRITE_TOKEN=write-token
#   ELASTIK_APPROVE_TOKEN=approve-token
ELASTIK_READ_TOKEN=
ELASTIK_WRITE_TOKEN=
ELASTIK_APPROVE_TOKEN=

# Pipeline trace. Set to "1" to enable the FSM trace on stderr (one line per
# phase + aux sub-steps for write verbs). Off by default. Read once at startup
# and frozen for the process lifetime; toggle by restart. See README "Pipeline
# Trace" for the format and a sample.
# ELASTIK_TRACE_PIPELINE=1
